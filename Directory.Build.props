<Project>
  <Import Project="$(MSBuildThisFileDirectory)Versions.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>

    <!-- Language Settings -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Code Style Enforcement. The documentation file also turns on the unused-using check (IDE0005) in the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- Authoring and NuGet packaging. Each package sets its own Version, Description and PackageTags in its project file. -->
  <PropertyGroup>
    <Authors>Aurore Development</Authors>
    <Company>AuroreLabs</Company>
    <Copyright>Copyright (c) 2026 AuroreLabs</Copyright>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/murilosdv/aur.foundation/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/murilosdv/aur.foundation</PackageProjectUrl>
    <RepositoryUrl>https://github.com/murilosdv/aur.foundation</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- Symbols and reproducible builds, so a package can be debugged and traced back to its commit. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Auto-detect test projects by path pattern. They are never packed. Test results go to /artifacts/test-results instead of a TestResults folder in the root. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('\tests\')) Or $(MSBuildProjectDirectory.Contains('/tests/'))">
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <TestingPlatformCommandLineArguments>--results-directory "$(MSBuildThisFileDirectory)artifacts/test-results"</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>

  <!-- Packages (everything that is not a test project): the README of the package, which nuget.org shows, is the one in its folder. -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
