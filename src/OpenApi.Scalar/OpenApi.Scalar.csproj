<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>$(OpenApiScalarVersion)</Version>
    <AssemblyName>Aurore.Foundation.OpenApi.Scalar</AssemblyName>
    <RootNamespace>Aurore.Foundation.OpenApi.Scalar</RootNamespace>
    <Product>Aurore Foundation @ OpenApi.Scalar</Product>
    <Description>The Scalar reference UI for the OpenAPI documents of the foundation: one document per API version and sign-in with PKCE.</Description>
    <PackageTags>aurore openapi scalar aspnetcore api-reference</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Scalar.AspNetCore.Microsoft" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenApi\OpenApi.csproj" />
  </ItemGroup>

</Project>
