<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>$(EntityFrameworkCoreSqlServerVersion)</Version>
    <AssemblyName>Aurore.Foundation.EntityFrameworkCore.SqlServer</AssemblyName>
    <RootNamespace>Aurore.Foundation.EntityFrameworkCore.SqlServer</RootNamespace>
    <Product>Aurore Foundation @ EntityFrameworkCore.SqlServer</Product>
    <Description>Entity Framework Core on SQL Server for Aurore projects: the SqlClient provider, filtered indexes, column helpers, unique violations and health check.</Description>
    <PackageTags>aurore entityframeworkcore efcore sqlserver soft-delete pagination</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The version the provider asks for pulls a Pkcs package with a known vulnerability; this one brings the fixed one. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EntityFrameworkCore\EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aurore.Foundation.Tests.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

</Project>
