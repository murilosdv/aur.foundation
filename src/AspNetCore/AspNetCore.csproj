<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>$(AspNetCoreVersion)</Version>
    <AssemblyName>Aurore.Foundation.AspNetCore</AssemblyName>
    <RootNamespace>Aurore.Foundation.AspNetCore</RootNamespace>
    <Product>Aurore Foundation @ AspNetCore</Product>
    <Description>ASP.NET Core building blocks: JWT and API key authentication, a request pipeline, minimal endpoints with versions, health checks and HTTP dependencies.</Description>
    <PackageTags>aurore aspnetcore minimal-api authentication health-checks</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aurore.Foundation.Tests.AspNetCore" />
    <InternalsVisibleTo Include="Aurore.Foundation.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Telemetry\Telemetry.csproj" />
  </ItemGroup>

</Project>
